# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Transcription provider: "deepgram" | "openai" | "fake"
PROVIDER_TRANSCRIPTION=fake

# Deepgram (when PROVIDER_TRANSCRIPTION=deepgram)
DEEPGRAM_API_KEY=your-deepgram-key
DEEPGRAM_CALLBACK_URL=https://your-app.vercel.app/api/transcription/callback

# OpenAI fallback (when PROVIDER_TRANSCRIPTION=openai)
OPENAI_API_KEY=your-openai-key

# Contributor token cookie secret (32+ random bytes, hex-encoded)
TOKEN_COOKIE_SECRET=change-me-to-a-64-char-hex-string

# App URL (used for building absolute URLs in emails/SMS)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Twilio (for SMS invite links — optional, email works without it)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
