# ─────────────────────────────────────────────────────────────────────────────
# Heritage Vault — environment variables
#
# ZERO-COST SETUP (recommended):
#   1. npx supabase start          → local Postgres + Auth + Storage (free)
#   2. docker compose up -d        → local Whisper transcription (free)
#   3. Copy the output of step 1 into the Supabase section below
#   4. Set PROVIDER_TRANSCRIPTION=whisper-local
#
# The only required third-party account is Supabase (free tier or self-hosted).
# No Deepgram, OpenAI, or Twilio key is needed for this setup.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase — get these from `npx supabase start` (local) or the dashboard (hosted)
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Transcription provider
#   fake          — fixture data, zero latency, no service needed (default for CI)
#   whisper-local — self-hosted Whisper via `docker compose up` (recommended)
#   deepgram      — Deepgram cloud API (requires API key)
#   openai        — OpenAI whisper-1 (requires API key, 25 MB cap)
PROVIDER_TRANSCRIPTION=whisper-local

# Local Whisper service (when PROVIDER_TRANSCRIPTION=whisper-local)
# Start with: docker compose up -d
WHISPER_LOCAL_URL=http://localhost:9000

# Deepgram (only needed when PROVIDER_TRANSCRIPTION=deepgram)
# DEEPGRAM_API_KEY=
# DEEPGRAM_CALLBACK_URL=https://your-app.example.com/api/transcription/callback

# OpenAI (only needed when PROVIDER_TRANSCRIPTION=openai)
# OPENAI_API_KEY=

# Contributor token cookie secret — generate with: openssl rand -hex 32
TOKEN_COOKIE_SECRET=change-me-to-a-64-char-hex-string

# App URL (used for building invite links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Twilio SMS (optional — email invite links work without this)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
