# ─────────────────────────────────────────────────────────────────────────────
# Heritage Vault — environment variables
#
# DEFAULT SETUP — hosted Supabase + local Whisper:
#   1. Grab the URL + keys from the Supabase dashboard (Project Settings → API)
#   2. docker compose up -d        → local Whisper transcription (free)
#   3. Set PROVIDER_TRANSCRIPTION=whisper-local
#
# The hosted project holds the schema, the vault-media bucket and the seed
# data. The old hand-rolled local stack (docker/docker-compose.host.yml) was
# removed on 2026-10-26 — don't expect a local Postgres to be running.
#
# OPTIONAL — local Supabase via the CLI:
#   npx supabase start (or npm run db:start) brings up Postgres + Auth +
#   Storage on 127.0.0.1:54321. You only need this to run the pgTAP RLS suite
#   (npm run db:test) or to rebuild from migrations (npm run db:reset), since
#   both require a local database. Swap the URL/keys below for its output.
#
# The only required third-party account is Supabase (free tier is enough).
# No Deepgram, OpenAI, or Twilio key is needed for this setup.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase — from the dashboard (hosted) or `npx supabase start` (local CLI)
#
# NOTE: hosted project URLs end in .supabase.co — NOT .supabase.com.
# The .com form does not resolve and every request fails silently.
#
# @supabase/ssr is pinned at 0.5.2 here, which predates publishable-key
# support — use the legacy anon JWT, not the newer sb_publishable_* key.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Transcription provider
#   fake          — fixture data, zero latency, no service needed (default for CI)
#   whisper-local — self-hosted Whisper via `docker compose up` (recommended)
#   deepgram      — Deepgram cloud API (requires API key)
#   openai        — OpenAI whisper-1 (requires API key, 25 MB cap)
PROVIDER_TRANSCRIPTION=whisper-local

# Local Whisper service (when PROVIDER_TRANSCRIPTION=whisper-local)
# Start with: docker compose up -d
WHISPER_LOCAL_URL=http://localhost:9000

# Deepgram (only needed when PROVIDER_TRANSCRIPTION=deepgram)
# DEEPGRAM_API_KEY=
# DEEPGRAM_CALLBACK_URL=https://your-app.example.com/api/transcription/callback
#
# REQUIRED for /api/transcription/callback to accept anything at all. That route
# writes with the service-role client (bypasses RLS), so it fails closed with a
# 500 until this is set — even when PROVIDER_TRANSCRIPTION is not deepgram.
# Generate with: openssl rand -hex 32
# DEEPGRAM_WEBHOOK_SECRET=

# OpenAI (only needed when PROVIDER_TRANSCRIPTION=openai)
# OPENAI_API_KEY=

# Contributor token cookie secret — generate with: openssl rand -hex 32
TOKEN_COOKIE_SECRET=change-me-to-a-64-char-hex-string

# App URL (used for building invite links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Twilio SMS (optional — email invite links work without this)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
